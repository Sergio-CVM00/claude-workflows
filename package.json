{
  "name": "claude-workflows",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "catalog:write": "node scripts/catalog.mjs --write",
    "catalog:check": "node scripts/catalog.mjs --check",
    "typecheck": "tsc --noEmit --strict --target es2022 --module nodenext skills/claude-workflows/types/workflow-api.d.ts skills/claude-workflows/types/contracts.typecheck.ts",
    "test": "node --test tests/*.test.mjs skills/claude-workflows/tests/*.test.mjs",
    "check": "node scripts/catalog.mjs --check && node scripts/check-package.mjs && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
